{
  "capability": "dynamics.inverse_dynamics",
  "format": "curobo-metal-replay-corpus",
  "inputs": [
    "robot_urdf_utf8",
    "q",
    "dynamics_velocity",
    "dynamics_acceleration",
    "dynamics_noncontiguous_source"
  ],
  "required_matrix": {
    "cases": ["zero_motion", "batched_layout", "noncontiguous_state", "result_isolation", "vjp"],
    "output": "matrix_observed"
  },
  "required_evidence": {
    "edge": {
      "case": "two_batch_gradients",
      "output": "edge_observed"
    },
    "invalid": {
      "case": "missing_acceleration",
      "output": "invalid_rejected"
    }
  },
  "tensors": {
    "dynamics_noncontiguous_source": {"dtype": "float32", "shape": [2, 4], "data": [[0.0, 99.0, 0.25, 99.0], [-0.5, 99.0, 0.75, 99.0]]}
  },
  "version": 1
}
