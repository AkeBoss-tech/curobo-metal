{
  "capability": "types.solver_results",
  "format": "curobo-metal-replay-corpus",
  "inputs": [
    "q"
  ],
  "required_matrix": {
    "cases": ["zero", "one", "many", "mixed_status", "clone_mutation"],
    "output": "matrix_observed"
  },
  "required_evidence": {
    "edge": {
      "case": "mixed_status",
      "output": "edge_observed"
    },
    "invalid": {
      "case": "invalid_status",
      "output": "invalid_rejected"
    }
  },
  "version": 1
}
