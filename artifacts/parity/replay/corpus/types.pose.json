    "pose_noncontiguous_source": {"dtype": "float32", "shape": [2, 6], "data": [[0.2, 99.0, 0.2, 99.0, 0.5, 99.0], [2.0, 99.0, 0.0, 99.0, 0.0, 99.0]]}
  },
  "version": 1
}
