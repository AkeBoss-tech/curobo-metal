{
  "capability": "types.joint_state",
  "format": "curobo-metal-replay-corpus",
  "inputs": [
    "joint_position",
    "joint_velocity",
    "joint_acceleration",
    "joint_jerk",
    "joint_dt",
    "joint_kernel",
    "joint_noncontiguous_source"
  ],
  "required_matrix": {
    "cases": ["zero", "one", "many", "noncontiguous", "optional_channels", "mutation", "vjp"],
    "output": "matrix_observed"
  },
  "required_evidence": {
    "edge": {
      "case": "noncontiguous_state",
      "output": "edge_observed"
    },
    "invalid": {
      "case": "name_width_mismatch",
      "output": "invalid_rejected"
    }
  },
  "tensors": {
    "joint_position": {
      "dtype": "float32",
      "shape": [2, 2],
      "data": [[0.0, 0.25], [-0.5, 0.75]]
    },
    "joint_velocity": {
      "dtype": "float32",
      "shape": [2, 2],
      "data": [[1.0, 2.0], [3.0, 4.0]]
    },
    "joint_acceleration": {
      "dtype": "float32",
      "shape": [2, 2],
      "data": [[-1.0, 0.5], [1.5, -2.0]]
    },
    "joint_jerk": {
      "dtype": "float32",
      "shape": [2, 2],
      "data": [[0.125, -0.25], [0.5, 1.0]]
    },
    "joint_dt": {
      "dtype": "float32",
      "shape": [2, 1],
      "data": [[0.1], [0.2]]
    },
    "joint_kernel": {
      "dtype": "float32",
      "shape": [3, 2],
      "data": [[1.0, 0.0], [0.25, 0.75], [-1.0, 2.0]]
    },
    "joint_noncontiguous_source": {
      "dtype": "float32",
      "shape": [2, 4],
      "data": [[0.0, 99.0, 0.25, 99.0], [-0.5, 99.0, 0.75, 99.0]]
    }
  },
  "version": 1
}
