<?xml version="1.0"?>
<robot name="tiny_tree">
  <link name="base"/>
  <link name="arm">
    <inertial>
      <origin xyz="0.1 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.2" iyy="0.3" izz="0.4" ixy="0.01" ixz="0.02" iyz="0.03"/>
    </inertial>
  </link>
  <link name="tip"/>
  <link name="finger"/>
  <joint name="shoulder" type="revolute">
    <parent link="base"/>
    <child link="arm"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 0 2"/>
    <limit lower="-1.5" upper="1.25" velocity="2.5" effort="12"/>
  </joint>
  <joint name="tip_fixed" type="fixed">
    <parent link="arm"/>
    <child link="tip"/>
    <origin xyz="0.4 0 0"/>
  </joint>
  <joint name="finger_mimic" type="prismatic">
    <parent link="arm"/>
    <child link="finger"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.08" velocity="0.2" effort="4"/>
    <mimic joint="shoulder" multiplier="-0.02" offset="0.04"/>
  </joint>
</robot>
